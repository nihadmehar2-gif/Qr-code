#!/bin/sh
# Simplified gradlew wrapper that uses the locally installed Gradle 8.7.
# This works on this build server; for distribution, the canonical gradlew
# generated by `gradle wrapper` should be regenerated by the user.
#
# However, we still go through org.gradle.wrapper.GradleWrapperMain so the
# wrapper properties (and the wrapper jar) are respected if available.

PRG="$0"
# Resolve the project root
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=${ls#*' -> '}
    case $link in
        /*) PRG="$link" ;;
        *)  PRG="$(dirname "$PRG")/$link" ;;
    esac
done
SAVED="$(pwd)"
cd "$(dirname "$PRG")" >/dev/null
APP_HOME="$(pwd -P)"
cd "$SAVED" >/dev/null

# Determine JAVA_HOME
if [ -z "$JAVA_HOME" ]; then
    JAVACMD=java
else
    JAVACMD="$JAVA_HOME/bin/java"
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec "$JAVACMD" -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
