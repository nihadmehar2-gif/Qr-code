<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera for live scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- READ_MEDIA_IMAGES (API 33+) for gallery scan -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- READ_EXTERNAL_STORAGE for API <= 32 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Wi-Fi connection via suggestion API on API 29+ -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required by CHANGE_WIFI_STATE on some OEMs -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Phone / SMS / Email actions -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Calendar write -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Contacts -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!--
        Plain android.hardware.camera is implied as REQUIRED by the CAMERA permission
        (unless explicitly marked optional). Fire TV Stick / Cube have no camera at all,
        so this implied-required feature would filter them out of the Amazon Appstore.
        Marking it optional lets the app install on Fire TV (where the user can still
        use Gallery scan + QR generator) while still requesting CAMERA permission on
        devices that do have a camera (where the live scanner works).
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <!--
        Mark implied-required features as optional so that Amazon Fire TV (no camera, no GPS,
        no telephony), Fire Tablets without cellular, and Android Automotive head units
        without Wi-Fi can install the app from the Amazon Appstore.

        Without these declarations:
          - CALL_PHONE implies android.hardware.telephony (filters out Fire TV + Fire Tablets
            without cellular modems, since most Fire devices are Wi-Fi only).
          - ACCESS_FINE_LOCATION implies android.hardware.location.gps +
            android.hardware.location (filters out Fire TV, which has no GPS).
          - CHANGE_WIFI_STATE / ACCESS_WIFI_STATE imply android.hardware.wifi (filters out
            Android Automotive head units and any device without a Wi-Fi radio).

        The app's core features (QR generation, gallery scan, history, settings) work without
        any of these — only camera-based scanning, Wi-Fi QR connect, and Call/SMS actions
        require them, and those features already degrade gracefully at runtime (the user gets
        a clear error if the feature is missing).
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".QrApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QRScanner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QRScanner.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.scanner.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QRScanner.Scanner"
            tools:ignore="LockedOrientationActivity" />

        <!-- ML Kit barcode model dependencies are downloaded automatically by the library -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <!--
            FileProvider used by the QR Generator's Share button.
            We write the generated QR PNG to a private cache file
            (cacheDir/shared_qr/qr_share_<timestamp>.png) and expose it via this
            provider so other apps (WhatsApp, Gmail, etc.) can read it without
            needing WRITE_EXTERNAL_STORAGE permission.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
